^SAMPLE = GSM6132061
!Sample_title = ST_PDAC-1
!Sample_geo_accession = GSM6132061
!Sample_status = Public on May 30 2023
!Sample_submission_date = May 11 2022
!Sample_last_update_date = May 30 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = PDAC tumor tissue
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: human PDAC tumor
!Sample_characteristics_ch1 = feature: with Neural Hypertrophy and Schwann Cells Accumulation
!Sample_treatment_protocol_ch1 = PDAC tumors were surgically removed and embedded in optimal cutting temperature (OCT) compound (Sakura). The tissues treated with OCT compound were immediately frozen on dry ice. Tissue sections (10 μm thick) were placed within the frames of capture areas on Visium Spatial slides (10X Genomics) and imaged using a Pannoramic MIDI microscope (3DHISTECH) after H&E staining. Visium spatial tissue optimization slides and reagent kits (10X Genomics) were used for pre-permeabilization to optimize permeabilization time. For tissue permeabilization and spatial transcriptomic sequencing, the stained slides were incubated in RT Master Mix for 45 min at 53°C for reverse transcription after permeabilization. Next, Second Strand mix was added to the tissue sections on the slide and incubated for 15 min at 65°C to initiate second strand synthesis. After transferring the cDNA from the slides, it was purified via the barcode cDNA and amplified. The amplified barcoded cDNA was fragmented, A-tailed, ligated with adaptors, and amplified using PCR.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = ST transcriptomes were collected using 10X Chromium Spatial Gene Expression Slide & Reagent Kit.
!Sample_extract_protocol_ch1 = RNA libraries were prepared for sequencing using standard Illumina protocols
!Sample_data_processing = Basecalls performed using CASAVA version 1.8
!Sample_data_processing = Read alignment and count summarization were performed using SpaceRanger
!Sample_data_processing = Seurat package was used for spot normalization and regression. PCA was constructed based on the scaled data with all high variable genes and top 30 principals were used for tSNE construction. Utilizing graph-based cluster method, we acquired the unsupervised the cell cluster result based the PCA top 30 principal and we calculated the marker genes by FindAllMarkers function with wilcox rank sum test algorithm under following criteria:1. logFC > 0.25; 2. pvalue<0.05; 3. min.pct>0.1. Spatial feature expression plots were generated with the SpatialFeaturePlot function in Seurat (version 3.1.3) and the STUtility R package (version 1.0.0).
!Sample_data_processing = Assembly: GRCh38
!Sample_data_processing = Supplementary files format and content: MTX file and TSV file contain counts for each barcodes and genes
!Sample_platform_id = GPL24676
!Sample_contact_name = Meilin,,Xue
!Sample_contact_email = xuemeilin@sjtu.edu.cn
!Sample_contact_institute = Ruijin Hospital, Shanghai Jiao Tong University School of Medicine
!Sample_contact_address = 197 Ruijin 2nd Road
!Sample_contact_city = Shanghai
!Sample_contact_state = Shanghai
!Sample_contact_zip/postal_code = 200020
!Sample_contact_country = China
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN28191961
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX15233897
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6132nnn/GSM6132061/suppl/GSM6132061_PDAC-1.barcodes.tsv.gz
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6132nnn/GSM6132061/suppl/GSM6132061_PDAC-1.features.tsv.gz
!Sample_supplementary_file_3 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6132nnn/GSM6132061/suppl/GSM6132061_PDAC-1.matrix.mtx.gz
!Sample_supplementary_file_4 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6132nnn/GSM6132061/suppl/GSM6132061_PDAC-1.tif.gz
!Sample_series_id = GSE202740
!Sample_data_row_count = 0
