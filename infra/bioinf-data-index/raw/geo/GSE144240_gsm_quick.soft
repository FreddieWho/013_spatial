!Sample_contact_address = 1428 Madison Ave.
!Sample_contact_city = New York
!Sample_contact_state = NY
!Sample_contact_zip/postal_code = 10029
!Sample_contact_country = USA
!Sample_instrument_model = Illumina HiSeq 4000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN13919433
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX8383310
!Sample_supplementary_file_1 = NONE
