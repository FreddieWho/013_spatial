!Sample_library_selection = other
!Sample_library_source = transcriptomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN13919488
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX8383260
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM4284nnn/GSM4284320/suppl/GSM4284320_P5_ST_rep2.jpg.gz
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM4284nnn/GSM4284320/suppl/GSM4284320_P5_ST_rep2_stdata.tsv.gz
!Sample_supplementary_file_3 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM4284nnn/GSM4284320/suppl/GSM4284320_spot_data-selection-P5_ST_rep2.tsv.gz
