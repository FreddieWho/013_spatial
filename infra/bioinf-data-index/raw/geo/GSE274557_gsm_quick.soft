^SAMPLE = GSM8714183
!Sample_title = Pt-10_PDX
!Sample_geo_accession = GSM8714183
!Sample_status = Public on Feb 21 2025
!Sample_submission_date = Jan 06 2025
!Sample_last_update_date = Jun 18 2025
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = PDX for primary PDAC
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: PDX for primary PDAC
!Sample_characteristics_ch1 = age: 64
!Sample_characteristics_ch1 = Sex: male
!Sample_characteristics_ch1 = treatment: FOLFIRINOX, carboplatin/FOLFOX, gemcitabine/abraxane
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = The frozen tissue samples were embedded in OCT, and then cryo-sectioned to a thickness of 10μm using a cryostat. FFPE tissue sections from PDX models were cut to a thickness of 5μm using a microtome. Subsequently, these sections were stained with Hematoxylin and Eosin (H&E) for histological examination. After sectioning onto the Visium slides, sample processing was performed as described in the Visium 10x Genomics protocol for fresh-frozen tissue samples (15 minutes were used for permealization time) or the Visium CytAssist Spatial Gene Expression protocol for FFPE tissue samples.
!Sample_extract_protocol_ch1 = Library preparation for frozen tissue samples was performed as described in  the Visium Spatial Gene Expression Reagent Kit (PN-1000189), Library Construction Kit (PN-1000196), and Dual Index Plate TT Set A (PN-3000431) as described in the Visium protocol for fresh frozen tissue samples (CG000239). FFPE tissue sections for PDX models were prepared following the 6.5 x 6.5 mm Visium CytAssist Spatial Gene Expression protocol (CG000518 for tissue preparation, CG000520 for deparaffinization and H&E staining, and CG000495 for library construction, 10X Genomics).
!Sample_description = Library name: Pt-10_PDX
!Sample_description = FFPE Visium CytAssist ST sequencing
!Sample_data_processing = The demultiplexed reads were processed using Space Ranger (v.1.3.1 or 2.1.0) from 10x Genomics, aligned to the GRCh38 reference genome with default parameters. The resulting unique molecular identifier (UMI) count matrices were then analysed using Seurat (v.4.3) 47 in the R platform (v.4.2.0). Detailed quality control (QC) metrics were generated and evaluated, and spots were carefully filtered to obtain high-quality SRT data for downstream analyses. Briefly, for basic quality filtering, spots with low complexity libraries (UMI count below 100) were filtered out to eliminate low-quality spots. Additionally, spots located within acellular stromal interfaces were excluded and samples with more than 40% low-quality spots were also excluded from subsequent analyses.
!Sample_data_processing = Assembly: GRCh38 reference genome
!Sample_data_processing = Supplementary files format and content: spatial.tar.gz : Compressed tar archives include processed output from Space Ranger with spatial information
!Sample_data_processing = Supplementary files format and content: filtered_feature_bc_matrix.h5 : Filtered feature-barcode matrices in HDF5 format
!Sample_data_processing = Library strategy: Spatial Transcriptomics
!Sample_platform_id = GPL24676
