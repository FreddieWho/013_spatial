# Local agent/runtime state
/.agents/
/.codex/
/.pi/
/.ipynb_checkpoints/
/.venv_hest/
**/.ipynb_checkpoints/
__pycache__/
*.py[cod]

# Large local data: track only the human-readable inventory at this level.
/data/*
!/data/README.md
!/data/DATA_BRIEFING.md

# Upstream paper code remains an independent Git repository.
/repo/

# Only the current small, reviewed paper metadata assets are versioned.
/paper/*
!/paper/pancan_spatial_atlas_data.png
!/paper/science.adz2742_tables_s1_to_s8.zip
!/paper/tables/
/paper/tables/*
!/paper/tables/science.adz2742_tables_s1_to_s8.xlsx

# Local scratch and generated outputs.
/scratch/
/tmp/
*.log

# R-04 control-plane run artifacts: large, reproducible from scripts.
# Keep only the human-readable docs, the small machine-readable inputs
# referenced by code/tests, and the top-level gate/calibration records.
/infra/r04/*
!/infra/r04/README.md
!/infra/r04/environment.lock.json
!/infra/r04/config.example.json
!/infra/r04/*.json
!/infra/r04/*.tsv
!/infra/r04/*.txt
!/infra/r04/role_manifests/
!/infra/r04/remote_jobs_20260831/
!/infra/r04/continuation_platform_audit_20260831/
!/infra/r04/continuation_platform_audit_20260831_v2/
!/infra/r04/GPU_RUNBOOK.md
!/infra/r04/gpu_fold4_20260905/
!/infra/r04/gpu_k2_20260910/
!/infra/r04/composition_ref/
!/infra/r04/composition_ref/provenance.json
/infra/r04/composition_ref/*.npz

# HTAN R-03 external data: large download dirs stay out of git;
# manifests/metadata/provenance/scripts stay tracked.
/R03_external/HTAN/*/*/synapse/
/R03_external/HTAN/*/*/crdc_open/
/R03_external/HTAN/*/*/controlled/
/R03_external/HTAN/*/auxiliary_public/
/R03_external/HTAN/*/logs/
